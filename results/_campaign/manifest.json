      "sha256": "f9835a6d51408914f8b7baf44ff0fd9e2a20b8c0a5b881e5465286fe3569951b",
      "content": "federated_learning:\n  num_clients: 20\n  num_rounds: 100\n  fraction_fit: 0.5\n  fraction_evaluate: 0.3\n  local_epochs: 5\n  local_batch_size: 256\n  local_lr: 0.001\n\ntrust:\n  # Signal-mixing weights (alpha, beta, gamma) for the trust blend of paper\n  # Eq. (6). Table IV specifies \"Initial alpha,beta,gamma = 1/3 each\", so these\n  # are 1/3 each and NOT 0.4/0.4/0.2 as an earlier revision shipped.\n  #\n  # Who reads these three keys:\n  #   * `--strategy tvflids_fixed` (ablation A6) -- TrustScorer holds them fixed\n  #     for the whole run, so the CLI default must already BE the A6 setting.\n  #     experiments/run_ablation.py used to supply 1/3 via trust_override on top\n  #     of a 0.4/0.4/0.2 base, which made a direct CLI invocation silently\n  #     disagree with the ablation runner (and with the paper).\n  #   * `--strategy tvflids` (the proposed method) -- IGNORED. AdaptiveTrustScorer\n  #     always initializes log-weights at 0, i.e. softmax(0) = (1/3, 1/3, 1/3),\n  #     per Eq. (11); it never reads these keys. The values below therefore have\n  #     no effect on the adaptive method either before or after this correction.\n  # Sum must equal 1.0 to within 1e-5 (asserted in trust/trust_scorer.py).\n  alpha: 0.3333333333333333\n  beta: 0.3333333333333333\n  gamma: 0.3333333333333333\n  memory_decay: 0.9\n  min_trust: 0.01\n  meta_lr: 0.01\n\nverification:\n  # Nominal (post-warmup) gate thresholds \u2014 paper Table IV.\n  loss_threshold: 0.0        # tau_L  (Check 1)\n  cosine_threshold: 0.0      # tau_C  (Check 2) \u2014 fixed, never annealed\n  zscore_threshold: 2.5      # tau_z  (Check 3)\n  warmup_rounds: 20          # T_warm \u2014 drives BOTH annealing schedules\n  # Warmup annealing of tau_L and tau_z (paper Section IV-A, Eq. 5 and the\n  # Table IV footnote). Set false for a fixed-threshold gate (ablation).\n  adaptive_thresholds: true\n  warmup_loss_threshold: -0.1   # tau_L(0); annealed linearly to loss_threshold\n  warmup_zscore_offset: 0.5     # tau_z(0) = zscore_threshold + this (= 3.0)\n\nadversarial:\n  attack_ratio: 0.3\n  attack_type: \"label_flip\"\n  gradient_scale_factor: 10.0\n  noise_std: 0.5\n  backdoor_poison_ratio: 0.1\n\nevaluation:\n  seeds: [42, 123, 456, 789, 1337]\n  primary_seed: 42\n  target_accuracy: 0.88\n\n# Optional: enable to log last-round client params for Proposition 1 verification\nlog_client_params: false\n\n# Per-stage wall-clock instrumentation for the overhead table (paper Table XII).\n# Adds sub-millisecond bookkeeping per round; set false to disable entirely.\nenable_overhead_tracking: true\n"
    },
    {
